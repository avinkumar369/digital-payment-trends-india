# data_analysis.ipynb
# This notebook demonstrates the full workflow for the Digital Payment Trends project.
# It loads raw CSVs, preprocesses them, performs EDA, and generates the required visualizations.
# If the CSV files are not yet present, the notebook will raise a clear error with instructions.

# %%capture
%load_ext autoreload
%autoreload 2

# %%capture
import sys, os
PROJECT_ROOT = os.path.abspath(os.path.join(os.getcwd()))
src_path = os.path.join(PROJECT_ROOT, "src")
if src_path not in sys.path:
    sys.path.append(src_path)

# %%
from data_collection import load_npci_data, load_rbi_data
from preprocessing import clean_npci, clean_rbi, merge_datasets, save_processed
from eda import descriptive_stats, monthly_growth, correlation_matrix
from visualizations import (
    line_chart_upi_volume,
    bar_chart_payment_methods,
    area_chart_total_volume,
    donut_chart_method_distribution,
    heatmap_monthly_patterns,
    scatter_volume_vs_value,
    dual_axis_upi,
)
import pandas as pd
import plotly.io as pio
pio.renderers.default = "notebook"

# %% 
# Load raw data
npci_raw = load_npci_data()
rbi_raw = load_rbi_data()

# %% 
# Clean data
npci_clean = clean_npci(npci_raw)
rbi_clean = clean_rbi(rbi_raw)

# %% 
# Merge datasets
merged = merge_datasets(npci_clean, rbi_clean)

# %% 
# Save processed version for reuse
processed_path = save_processed(merged)
print(f"Processed data saved to {processed_path}")

# %% 
# --- Exploratory Data Analysis ---
print("Descriptive statistics:")
display(descriptive_stats(merged))

print("Month‑on‑month growth for UPI volume:")
display(monthly_growth(merged, "upi_volume"))

print("Correlation matrix:")
display(correlation_matrix(merged))

# %% 
# --- Visualizations ---
fig1 = line_chart_upi_volume(merged)
fig1.show()

fig2 = bar_chart_payment_methods(merged)
fig2.show()

fig3 = area_chart_total_volume(merged)
fig3.show()

fig4 = donut_chart_method_distribution(merged)
fig4.show()

fig5 = heatmap_monthly_patterns(merged)
fig5.show()

fig6 = scatter_volume_vs_value(merged)
fig6.show()

fig7 = dual_axis_upi(merged)
fig7.show()
